# ==============================================================================
#  As It Is — the update the app offers (update.json)
#  Lines starting with # are notes for you: the app skips them.
#
#  To offer a new version:
#   1. raise "versionCode" (always a higher whole number than before),
#   2. change "versionName", "notes" and the two links,
#   3. put the new APK's "sha256" and "sizeBytes" (from the build's summary).
#  A phone whose app has a LOWER versionCode is offered the update;
#  the same or higher: nothing is shown.
# ==============================================================================
{
  # This app's name on Android. Never change it.
  "packageName": "cc.asitis.app",

  # The newest version: its number and its name.
  "versionCode": 3,
  "versionName": "1.0",

  # What is new: shown in the update popup. Write \n for a new line.
  "notes": "Śrīla Prabhupāda's original books, downloaded once and then read without internet.",

  # true  = the update MUST be installed (no "Later"; the popup cannot be closed).
  # false = the reader may put it off.
  "mandatory": false,

  # Where the new APK is downloaded from: the primary link first;
  # if it does not give the app (blocked, missing, an error), the secondary link.
  # Both must start with https://
  "primaryLink": "https://app.asitis.cc/apk/AsItIs-v1.0.apk",
  "secondaryLink": "https://github.com/rushhour8/AsItIs-Releases/releases/download/v1.0/AsItIs-v1.0.apk",

  # (Recommended) the APK's SHA-256: every download is checked against it, so a
  # wrong or changed file is never installed. Leave "" to skip the check.
  "sha256": "28fc032f7b3cb58f8e4a63222c60f3887be101f579a7e69e66845c5de692a043",

  # (Optional) the APK's size in bytes, for the progress bar.
  "sizeBytes": 51277098
}
